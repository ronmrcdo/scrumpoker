# docker-compose environment variables.
# Copy to `.env` (same directory as docker-compose.yml) and fill in.

# Public Supabase config — baked into the web bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Plausible Analytics script URL.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=

# Shared secret between the web service and serverless-redis-http.
# Generate a strong random value (e.g. `openssl rand -hex 32`).
SRH_TOKEN=
