NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Plausible Analytics (full script URL from your Plausible dashboard)
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.scrumpokergame.com/js/pa-YOUR_KEY.js

# Upstash-compatible Redis for distributed rate limiting.
# In docker-compose these point at the bundled serverless-redis-http service.
# Leave unset to fall back to in-memory rate limiting (single-process only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
