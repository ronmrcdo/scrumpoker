# Required — these are baked into the JS bundle at build time
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — Plausible Analytics (full script URL from your Plausible dashboard)
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.scrumpokergame.com/js/pa-YOUR_KEY.js

# Optional — Cloudflare Turnstile (bot protection on room creation)
# Leave empty or remove these lines to disable Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
