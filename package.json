{
  "name": "scrumpokergame",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "db:types": "supabase gen types typescript --local > apps/web/lib/database.types.ts",
    "db:types:check": "supabase gen types typescript --local | diff -u apps/web/lib/database.types.ts -"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "supabase": "^2.75.4",
    "turbo": "^2.8.2"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.23.4"
  }
}
