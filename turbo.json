{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "biome.json"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "../../packages/typescript-config/*.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#format-and-lint": {
      "cache": false
    },
    "//#format-and-lint:fix": {
      "cache": false
    },
    "test": {
      "cache": false
    }
  }
}
